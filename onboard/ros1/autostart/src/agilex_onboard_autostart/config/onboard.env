# Vehicle / site identity. Changing this file does not require a new deb.
# systemd units load it via EnvironmentFile; start-* scripts still have
# last-resort defaults if the file is missing.
#
# Enable chassis at boot; it Wants standalone roscore. Other units stay
# install-only. Never let roslaunch create its own master.

ROS_DISTRO=melodic
ROS_MASTER_URI=http://127.0.0.1:11311
ROS_IP=127.0.0.1
HOME=/home/agilex
ROS_HOME=/home/agilex/.ros
ROSCORE_SETTLE_SEC=1
ROSCORE_WAIT_TIMEOUT=60
CHASSIS_STAGGER_SEC=2
IMU_STAGGER_SEC=4
MOCAP_STAGGER_SEC=4
CAMERA_STAGGER_SEC=6
SWARM_STAGGER_SEC=6
PANEL_STAGGER_SEC=6
LIDAR_STAGGER_SEC=8
BOOT_SETTLE_SEC=10
CAN_IF=can0
CAN_BITRATE=500000
IMU_DEVICE=/dev/imu
IMU_REQUIRED=0
SWARM_ROS_BRIDGE_CONFIG=/etc/xgc2/agilex/swarm_ros_bridge/ros_topics.yaml
FIELD_PANEL_PORT=8099
FIELD_PANEL_BIND=0.0.0.0
FIELD_PANEL_NS=ugv1
FIELD_PANEL_CMD_VEL=/cmd_vel
FIELD_PANEL_STATE_SOURCE=estimator
FIELD_PANEL_MOCAP=auto
FIELD_PANEL_OVERLAY=/opt/xgc2/shuttle_ws/devel/setup.bash

# Optional camera+teleop viewer (not field-panel). Default off.
# apt install ros-${ROS_DISTRO}-xgc2-agilex-onboard-teleop
# sudo systemctl enable --now xgc2-agilex-onboard-teleop.service
ONBOARD_TELEOP_PORT=8100
ONBOARD_TELEOP_BIND=0.0.0.0
ONBOARD_TELEOP_CMD_VEL=/cmd_vel
ONBOARD_TELEOP_STAGGER_SEC=6

# Motion-capture server and this vehicle's rigid body. Override per hall.
VRPN_SERVER=127.0.0.1
VRPN_PORT=3883
MOCAP_RIGID_BODY=pose_0
