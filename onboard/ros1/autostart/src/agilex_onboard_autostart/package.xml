<?xml version="1.0"?>
<package format="2">
  <name>agilex_onboard_autostart</name>
  <version>0.1.0</version>
  <description>Unified onboard systemd manager: base, communication, camera, and lidar units. Enables base for the next boot; does not start any unit now. Does not enable communication, camera, or lidar.</description>

  <maintainer email="apt@example.com">XGC2</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>agilex_swarm_ros_bridge</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>scout_base</exec_depend>
  <exec_depend>scout_description</exec_depend>
  <exec_depend>serial_imu</exec_depend>
  <exec_depend>xacro</exec_depend>
</package>
