#!/usr/bin/env bash
set -euo pipefail

CAN_IF="${CAN_IF:-can0}"
CAN_BITRATE="${CAN_BITRATE:-500000}"
TIMEOUT="${CAN_WAIT_TIMEOUT:-60}"

deadline=$((SECONDS + TIMEOUT))
while [[ ${SECONDS} -lt ${deadline} ]]; do
  if ip link show "${CAN_IF}" >/dev/null 2>&1; then
    break
  fi
  sleep 0.2
done

if ! ip link show "${CAN_IF}" >/dev/null 2>&1; then
  echo "CAN interface did not appear: ${CAN_IF}" >&2
  exit 1
fi

ip link set "${CAN_IF}" down >/dev/null 2>&1 || true
ip link set "${CAN_IF}" up type can bitrate "${CAN_BITRATE}"

if ! ip -details link show "${CAN_IF}" | grep -q "bitrate ${CAN_BITRATE}"; then
  echo "CAN interface ${CAN_IF} is not configured at bitrate ${CAN_BITRATE}" >&2
  ip -details link show "${CAN_IF}" >&2 || true
  exit 1
fi
