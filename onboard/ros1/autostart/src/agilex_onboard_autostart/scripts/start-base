#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
# shellcheck disable=SC1091
source "${ROS_PREFIX}/setup.bash"

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

sec="${BOOT_SETTLE_SEC:-10}"
echo "xgc2 agilex base: settle ${sec}s (USB CAN)"
sleep "${sec}"

enable_imu=true
if [[ "${IMU_REQUIRED:-1}" == "0" || -z "${IMU_DEVICE:-}" ]]; then
  enable_imu=false
  echo "xgc2 agilex base: IMU disabled (IMU_REQUIRED=${IMU_REQUIRED:-1})"
else
  "${ROS_PREFIX}/lib/agilex_onboard_autostart/wait-device" \
    "${IMU_DEVICE}" \
    --timeout "${IMU_DEVICE_WAIT_TIMEOUT:-90}"
fi

CAN_IF="${CAN_IF:-can0}"
TIMEOUT="${CAN_WAIT_TIMEOUT:-90}"
deadline=$((SECONDS + TIMEOUT))
while [[ ${SECONDS} -lt ${deadline} ]]; do
  if ip link show "${CAN_IF}" 2>/dev/null | grep -q "UP"; then
    break
  fi
  sleep 0.2
done
if ! ip link show "${CAN_IF}" 2>/dev/null | grep -q "UP"; then
  echo "CAN interface not up: ${CAN_IF}" >&2
  exit 1
fi

exec roslaunch agilex_onboard_autostart base.launch "enable_imu:=${enable_imu}"
