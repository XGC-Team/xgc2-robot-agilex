#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
# shellcheck disable=SC1091
source "${ROS_PREFIX}/setup.bash"

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

HERE="$(cd "$(dirname "$0")" && pwd)"
"${HERE}/wait-roscore"
stagger="${CHASSIS_STAGGER_SEC:-2}"
echo "xgc2 agilex chassis: stagger ${stagger}s after roscore"
sleep "${stagger}"

sec="${BOOT_SETTLE_SEC:-10}"
echo "xgc2 agilex chassis: settle ${sec}s (USB CAN)"
sleep "${sec}"

CAN_IF="${CAN_IF:-can0}"
TIMEOUT="${CAN_WAIT_TIMEOUT:-90}"
deadline=$((SECONDS + TIMEOUT))
while [[ ${SECONDS} -lt ${deadline} ]]; do
  if ip link show "${CAN_IF}" 2>/dev/null | grep -q "UP"; then
    break
  fi
  sleep 0.2
done
if ! ip link show "${CAN_IF}" 2>/dev/null | grep -q "UP"; then
  echo "CAN interface not up: ${CAN_IF}" >&2
  exit 1
fi

: "${XGC2_CHASSIS_ROBOT_ID:?site must supply its exact robot id}"
exec roslaunch --wait agilex_onboard_autostart chassis.launch \
  robot_id:="${XGC2_CHASSIS_ROBOT_ID}" \
  hold_port:="${XGC2_CHASSIS_HOLD_PORT:-19530}" \
  hold_key_file:="${XGC2_CHASSIS_HOLD_KEY_FILE:-/etc/xgc2/chassis-hold.key}" \
  hold_boot_held:="${XGC2_CHASSIS_HOLD_BOOT_HELD:-false}" \
  hold_required:="${XGC2_CHASSIS_HOLD_REQUIRED:-true}"
