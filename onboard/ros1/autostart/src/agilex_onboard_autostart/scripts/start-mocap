#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
if [[ -f "${ROS_PREFIX}/setup.bash" ]]; then
  # shellcheck disable=SC1090
  set +u
  source "${ROS_PREFIX}/setup.bash"
  set -u
fi

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

HERE="$(cd "$(dirname "$0")" && pwd)"
"${HERE}/wait-roscore"
stagger="${MOCAP_STAGGER_SEC:-4}"
echo "xgc2 agilex mocap: stagger ${stagger}s after roscore"
sleep "${stagger}"

if rospack find agilex_estimator >/dev/null 2>&1; then
  :
else
  echo "agilex mocap: package agilex_estimator not on ROS_PACKAGE_PATH" >&2
  exit 1
fi

SERVER="${VRPN_SERVER:-127.0.0.1}"
PORT="${VRPN_PORT:-3883}"
TRACKER="${MOCAP_RIGID_BODY:-pose_0}"

echo "xgc2 agilex mocap: ${TRACKER}@${SERVER}:${PORT} (no vision_pose)"
exec roslaunch --wait agilex_estimator mocap.launch \
  server:="${SERVER}" \
  port:="${PORT}" \
  tracker:="${TRACKER}"
