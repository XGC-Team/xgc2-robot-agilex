#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
set +u
source "${ROS_PREFIX}/setup.bash"
set -u

if [[ -n "${ONBOARD_TELEOP_OVERLAY:-}" && -f "${ONBOARD_TELEOP_OVERLAY}" ]]; then
  # shellcheck disable=SC1090
  set +u
  source "${ONBOARD_TELEOP_OVERLAY}"
  set -u
fi

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

"${HERE}/wait-roscore"
sec="${ONBOARD_TELEOP_STAGGER_SEC:-${PANEL_STAGGER_SEC:-6}}"
echo "xgc2 onboard teleop: stagger ${sec}s after roscore"
sleep "${sec}"

if ! rospack find xgc2_onboard_teleop >/dev/null 2>&1; then
  echo "xgc2 onboard teleop: package xgc2_onboard_teleop is not installed" >&2
  echo "apt install ros-${ROS_DISTRO}-xgc2-agilex-onboard-teleop" >&2
  exit 1
fi

exec roslaunch --wait xgc2_onboard_teleop teleop.launch \
  port:="${ONBOARD_TELEOP_PORT:-8100}" \
  bind:="${ONBOARD_TELEOP_BIND:-0.0.0.0}" \
  cmd_vel:="${ONBOARD_TELEOP_CMD_VEL:-/cmd_vel}"
