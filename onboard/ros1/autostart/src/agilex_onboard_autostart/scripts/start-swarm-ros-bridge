#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
# shellcheck disable=SC1091
source "${ROS_PREFIX}/setup.bash"

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

wait_master() {
  local timeout="${1:-60}"
  local deadline=$((SECONDS + timeout))
  while [[ ${SECONDS} -lt ${deadline} ]]; do
    if rosnode list >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done
  echo "ROS master did not appear" >&2
  return 1
}

wait_topic() {
  local topic="$1"
  local timeout="${2:-90}"
  local deadline=$((SECONDS + timeout))
  while [[ ${SECONDS} -lt ${deadline} ]]; do
    if rostopic list 2>/dev/null | grep -qx "${topic}"; then
      return 0
    fi
    sleep 0.2
  done
  echo "topic did not appear: ${topic}" >&2
  return 1
}

sec="${COMM_SETTLE_SEC:-2}"
echo "xgc2 agilex communication: settle ${sec}s"
sleep "${sec}"

wait_master "${ROS_MASTER_WAIT_TIMEOUT:-60}"
wait_topic "${SCOUT_STATUS_TOPIC:-/scout_status}" "${SCOUT_STATUS_WAIT_TIMEOUT:-90}"
if [[ "${IMU_REQUIRED:-0}" == "1" || -e "${IMU_DEVICE:-/dev/imu}" ]]; then
  wait_topic "${IMU_READY_TOPIC:-/imu/data}" "${IMU_TOPIC_WAIT_TIMEOUT:-90}"
fi

CONFIG="${SWARM_ROS_BRIDGE_CONFIG:-/etc/xgc2/agilex/swarm_ros_bridge/ros_topics.yaml}"
exec roslaunch agilex_swarm_ros_bridge swarm.launch config:="${CONFIG}"
