[Unit]
Description=XGC2 AgileX base (chassis, IMU, TF)
After=network.target local-fs.target systemd-modules-load.service systemd-udevd.service
# Communication, camera, and LiDAR are separate services.

[Service]
Type=simple
User=agilex
Group=agilex
SupplementaryGroups=dialout
WorkingDirectory=/home/agilex
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=ROS_DISTRO=melodic
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
Environment=ROS_IP=127.0.0.1
Environment=HOME=/home/agilex
Environment=ROS_HOME=/home/agilex/.ros
Environment=BOOT_SETTLE_SEC=10
Environment=CAN_IF=can0
Environment=CAN_BITRATE=500000
Environment=CAN_WAIT_TIMEOUT=90
Environment=IMU_DEVICE=/dev/imu
Environment=IMU_DEVICE_WAIT_TIMEOUT=90
# setup-can0 needs root; + runs this ExecStartPre as root on systemd 237+.
ExecStartPre=+/opt/ros/melodic/lib/agilex_onboard_autostart/setup-can0
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-base
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=240
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
