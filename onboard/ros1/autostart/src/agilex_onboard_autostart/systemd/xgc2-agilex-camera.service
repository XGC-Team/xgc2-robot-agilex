[Unit]
Description=XGC2 AgileX D435i camera
After=network.target systemd-udevd.service xgc2-agilex-base.service

[Service]
Type=simple
User=agilex
Group=agilex
SupplementaryGroups=dialout
WorkingDirectory=/home/agilex
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=ROS_DISTRO=melodic
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
Environment=ROS_IP=127.0.0.1
Environment=HOME=/home/agilex
Environment=ROS_HOME=/home/agilex/.ros
Environment=CAMERA_SETTLE_SEC=5
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-camera
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
