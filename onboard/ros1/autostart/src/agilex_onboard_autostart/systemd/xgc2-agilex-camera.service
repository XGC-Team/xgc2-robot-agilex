[Unit]
Description=XGC2 AgileX D435i camera
After=network.target systemd-udevd.service xgc2-agilex-chassis.service

[Service]
Type=simple
User=agilex
Group=agilex
SupplementaryGroups=dialout
WorkingDirectory=/home/agilex
# Install-only. Agent or a manual start owns experiment-time camera.
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-camera
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
