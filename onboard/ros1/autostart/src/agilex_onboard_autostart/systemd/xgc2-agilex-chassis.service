[Unit]
Description=XGC2 AgileX chassis (CAN driver and TF)
After=network.target local-fs.target systemd-modules-load.service systemd-udevd.service
StartLimitIntervalSec=0
# IMU, communication, camera, and LiDAR are separate services.

[Service]
Type=simple
User=agilex
Group=agilex
SupplementaryGroups=dialout
WorkingDirectory=/home/agilex
# Site identity (ROS_*, CAN_*, HOME) lives only in onboard.env.
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
# setup-can0 needs root; + runs this ExecStartPre as root on systemd 237+.
ExecStartPre=+/opt/ros/melodic/lib/agilex_onboard_autostart/setup-can0
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-chassis
Restart=always
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
