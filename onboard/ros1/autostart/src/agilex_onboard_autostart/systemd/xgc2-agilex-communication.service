[Unit]
Description=XGC2 AgileX communication (swarm_ros_bridge)
After=network.target xgc2-agilex-base.service

[Service]
Type=simple
User=agilex
Group=agilex
WorkingDirectory=/home/agilex
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=ROS_DISTRO=melodic
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
Environment=ROS_IP=127.0.0.1
Environment=HOME=/home/agilex
Environment=ROS_HOME=/home/agilex/.ros
Environment=COMM_SETTLE_SEC=2
Environment=SWARM_ROS_BRIDGE_CONFIG=/etc/xgc2/agilex/swarm_ros_bridge/ros_topics.yaml
Environment=IMU_READY_TOPIC=/imu/data
Environment=SCOUT_STATUS_TOPIC=/scout_status
Environment=ROS_MASTER_WAIT_TIMEOUT=60
Environment=IMU_TOPIC_WAIT_TIMEOUT=90
Environment=SCOUT_STATUS_WAIT_TIMEOUT=90
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-communication
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=240
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
