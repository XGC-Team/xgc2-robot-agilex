[Unit]
Description=XGC2 AgileX optional HI226 serial IMU
After=network.target systemd-udevd.service xgc2-agilex-chassis.service
StartLimitIntervalSec=0
# Install-only. Enable on hosts that have the HI226 /dev/imu accessory.

[Service]
Type=simple
User=agilex
Group=agilex
SupplementaryGroups=dialout
WorkingDirectory=/home/agilex
# IMU_DEVICE and ROS_* come from onboard.env. Install-only unless this host
# has the HI226 accessory.
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-imu-hi226
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
