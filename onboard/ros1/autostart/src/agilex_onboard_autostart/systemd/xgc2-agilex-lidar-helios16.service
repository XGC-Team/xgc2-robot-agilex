[Unit]
Description=XGC2 AgileX RoboSense Helios 16 lidar
After=network.target xgc2-agilex-chassis.service

[Service]
Type=simple
User=agilex
Group=agilex
WorkingDirectory=/home/agilex
# Install-only. Agent or a manual start owns experiment-time lidar.
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-lidar-helios16
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
