[Unit]
Description=XGC2 AgileX RoboSense Helios 16 lidar
After=network.target xgc2-agilex-chassis.service

[Service]
Type=simple
User=agilex
Group=agilex
WorkingDirectory=/home/agilex
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=ROS_DISTRO=melodic
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
Environment=ROS_IP=127.0.0.1
Environment=HOME=/home/agilex
Environment=ROS_HOME=/home/agilex/.ros
Environment=LIDAR_SETTLE_SEC=5
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-lidar-helios16
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
