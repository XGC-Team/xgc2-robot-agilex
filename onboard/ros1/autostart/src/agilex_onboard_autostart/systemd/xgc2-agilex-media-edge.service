[Unit]
Description=XGC2 AgileX Media Edge (WebRTC)
After=network-online.target xgc2-agilex-camera.service
Wants=network-online.target

[Service]
Type=simple
User=agilex
Group=agilex
RuntimeDirectory=xgc2/media-edge
RuntimeDirectoryMode=0700
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-media-edge
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
