[Unit]
Description=XGC2 AgileX VRPN client and pose/twist/accel relay
After=network.target xgc2-agilex-chassis.service

[Service]
Type=simple
User=agilex
Group=agilex
WorkingDirectory=/home/agilex
# VRPN_SERVER / VRPN_PORT / MOCAP_RIGID_BODY come from onboard.env.
# Install-only: do not enable at boot. Agent process.run-definition
# (agilex-mocap-ros1) starts this for a Session with per-run parameters.
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-mocap
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
