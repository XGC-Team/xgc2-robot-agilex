[Unit]
Description=XGC2 AgileX standalone ROS1 master
After=network.target
Before=xgc2-agilex-chassis.service xgc2-agilex-imu-hi226.service xgc2-agilex-camera.service xgc2-agilex-lidar-helios16.service xgc2-agilex-swarm-ros-bridge.service xgc2-agilex-mocap.service xgc2-field-panel.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=agilex
Group=agilex
WorkingDirectory=/home/agilex
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-roscore
Restart=always
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
