[Unit]
Description=XGC2 AgileX swarm_ros_bridge
After=network.target xgc2-agilex-chassis.service

[Service]
Type=simple
User=agilex
Group=agilex
WorkingDirectory=/home/agilex
# Install-only. Bridge config path and IMU flags live in onboard.env.
# Agent or a manual start owns experiment-time comms.
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-swarm-ros-bridge
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=240
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
