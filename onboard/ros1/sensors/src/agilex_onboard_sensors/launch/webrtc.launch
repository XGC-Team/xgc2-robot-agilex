<launch>
  <!-- Default WebRTC path: native V4L2 owner. Stop realsense2_camera first.
       If the USB device is already owned, use fallback_webrtc.launch instead. -->
  <arg name="device" default="/dev/video0" />
  <include file="$(find agilex_onboard_sensors)/launch/webrtc_native.launch">
    <arg name="device" value="$(arg device)" />
  </include>
</launch>
