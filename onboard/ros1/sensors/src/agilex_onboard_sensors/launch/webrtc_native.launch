<launch>
  <!-- Color preview when THIS process owns the V4L2 node.
       Stop realsense2_camera first. Not ros_fallback_rtp. -->
  <arg name="device" default="/dev/video0" />
  <arg name="width" default="640" />
  <arg name="height" default="480" />
  <arg name="fps" default="30" />
  <arg name="pixel_format" default="mjpeg" />
  <arg name="encoder" default="x264" />
  <arg name="source_id" default="color" />
  <arg name="rtp_port" default="5004" />
  <arg name="control_socket" default="/tmp/xgc2/media/color.sock" />

  <node name="xgc_native_v4l2_rtp" pkg="agilex_onboard_sensors" type="start-native-rtp"
        output="screen"
        args="--device $(arg device) --width $(arg width) --height $(arg height) --fps $(arg fps) --pixel-format $(arg pixel_format) --encoder $(arg encoder) --source-id $(arg source_id) --frame-id camera_color_optical_frame --rtp-port $(arg rtp_port) --control-socket $(arg control_socket)" />
</launch>
