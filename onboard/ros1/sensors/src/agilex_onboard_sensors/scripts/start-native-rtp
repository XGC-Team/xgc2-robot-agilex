#!/usr/bin/env bash
set -euo pipefail
HERE="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
for c in \
  "$(command -v xgc_native_v4l2_rtp || true)" \
  "/opt/ros/${ROS_DISTRO:-melodic}/lib/xgc2_camera_driver/xgc_native_v4l2_rtp" \
  "${HERE}/../../xgc_camera_media/xgc_native_v4l2_rtp"
do
  if [[ -n "${c}" && -x "${c}" ]]; then
    exec "${c}" "$@"
  fi
done
echo "xgc_native_v4l2_rtp not found" >&2
exit 1
