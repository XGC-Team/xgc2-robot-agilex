#!/usr/bin/env python
"""Publish the bag-validated ScoutStatus fields as standard ROS messages.

Source: /media/lxk/U128/xgc2-rosbags/agilex-all-20260815-000809.bag
and the Scout Mini / Scout 2.0 CAN manuals.

Bridged at 1 Hz (official swarm_ros_bridge only carries Imu/Twist/String):

  /scout/twist        geometry_msgs/Twist
      linear.x  = linear_velocity   # bag -1.56..1.51 m/s
      angular.z = angular_velocity  # bag -1.12..1.06 rad/s

  /scout/status_text  std_msgs/String
      mode        control_mode   # protocol: 0 RC, 1 CAN, 2 UART; this bag was 3
      base        base_state     # 0 normal in the bag
      fault       fault_code     # 0 in the bag
      batt        battery_voltage  # bag 23.0..23.7 V
      light_mode  front light mode # bag always 2 = breath
      light       front custom   # bag 0..100, matches CAN brightness

Not forwarded (not valid or not present on this vehicle status):
  light_control_enabled  stayed false while lights actually changed
  rear light custom      messenger currently copies the front value
  motor temperature      stuck at 30 C
  RC gear (SWD)          not in ScoutStatus
"""
from __future__ import print_function

import rospy
from geometry_msgs.msg import Twist
from scout_msgs.msg import ScoutStatus
from std_msgs.msg import String


def main():
    rospy.init_node("scout_status_to_std")
    rate_hz = float(rospy.get_param("~rate", 1.0))
    twist_topic = rospy.get_param("~twist_topic", "/scout/twist")
    text_topic = rospy.get_param("~text_topic", "/scout/status_text")
    latest = {"msg": None}

    def on_status(msg):
        latest["msg"] = msg

    rospy.Subscriber("/scout_status", ScoutStatus, on_status, queue_size=1)
    twist_pub = rospy.Publisher(twist_topic, Twist, queue_size=1)
    text_pub = rospy.Publisher(text_topic, String, queue_size=1)
    rate = rospy.Rate(rate_hz)

    while not rospy.is_shutdown():
        msg = latest["msg"]
        if msg is not None:
            twist = Twist()
            twist.linear.x = msg.linear_velocity
            twist.angular.z = msg.angular_velocity
            twist_pub.publish(twist)

            text = String()
            text.data = (
                "mode=%u base=%u fault=%u batt=%.2f light_mode=%u light=%u"
                % (
                    msg.control_mode,
                    msg.base_state,
                    msg.fault_code,
                    msg.battery_voltage,
                    msg.front_light_state.mode,
                    msg.front_light_state.custom_value,
                )
            )
            text_pub.publish(text)
        rate.sleep()


if __name__ == "__main__":
    main()
