#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
# shellcheck disable=SC1091
source "${ROS_PREFIX}/setup.bash"

"${ROS_PREFIX}/lib/agilex_onboard_autostart/wait-ros-master" --timeout "${ROS_MASTER_WAIT_TIMEOUT:-60}"
"${ROS_PREFIX}/lib/agilex_onboard_autostart/wait-device" "${IMU_DEVICE:-/dev/imu}" --timeout "${IMU_DEVICE_WAIT_TIMEOUT:-60}"

exec roslaunch agilex_onboard_autostart imu.launch
