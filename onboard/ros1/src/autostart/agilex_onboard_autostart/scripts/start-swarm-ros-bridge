#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
# shellcheck disable=SC1091
source "${ROS_PREFIX}/setup.bash"

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"

"${ROS_PREFIX}/lib/agilex_onboard_autostart/wait-ros-master" --timeout "${ROS_MASTER_WAIT_TIMEOUT:-60}"
"${ROS_PREFIX}/lib/agilex_onboard_autostart/wait-ros-topic" "${IMU_READY_TOPIC:-/imu/data_raw}" --timeout "${IMU_TOPIC_WAIT_TIMEOUT:-90}"
"${ROS_PREFIX}/lib/agilex_onboard_autostart/wait-ros-topic" "${SCOUT_STATUS_TOPIC:-/scout_status}" --timeout "${SCOUT_STATUS_WAIT_TIMEOUT:-90}"

exec roslaunch swarm_ros_bridge test.launch
