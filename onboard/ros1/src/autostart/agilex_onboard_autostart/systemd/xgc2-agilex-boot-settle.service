[Unit]
Description=XGC2 AgileX boot settle for USB CAN and IMU
After=local-fs.target systemd-modules-load.service systemd-udevd.service
Before=xgc2-agilex-imu.service xgc2-agilex-chassis.service
PartOf=xgc2-agilex-onboard.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=BOOT_SETTLE_SEC=10
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-boot-settle
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=xgc2-agilex-onboard.target
