[Unit]
Description=XGC2 AgileX CAN interface setup
After=local-fs.target systemd-modules-load.service systemd-udevd.service xgc2-agilex-boot-settle.service
Wants=xgc2-agilex-boot-settle.service
PartOf=xgc2-agilex-onboard.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=CAN_IF=can0
Environment=CAN_BITRATE=500000
Environment=CAN_WAIT_TIMEOUT=90
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/setup-can0
RemainAfterExit=yes
TimeoutStartSec=120
# systemd 237 (Bionic) rejects Restart= on Type=oneshot + RemainAfterExit=yes.

[Install]
WantedBy=xgc2-agilex-onboard.target
