[Unit]
Description=XGC2 AgileX onboard IMU
Requires=xgc2-roscore.service
After=xgc2-roscore.service xgc2-agilex-boot-settle.service systemd-udevd.service
Wants=xgc2-agilex-boot-settle.service
PartOf=xgc2-agilex-onboard.target

[Service]
Type=simple
User=agilex
Group=agilex
SupplementaryGroups=dialout
WorkingDirectory=/home/agilex
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=ROS_DISTRO=melodic
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
Environment=ROS_IP=127.0.0.1
Environment=HOME=/home/agilex
Environment=ROS_HOME=/home/agilex/.ros
Environment=IMU_DEVICE=/dev/imu
Environment=IMU_DEVICE_WAIT_TIMEOUT=90
Environment=ROS_MASTER_WAIT_TIMEOUT=60
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-imu
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=180
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=xgc2-agilex-onboard.target
