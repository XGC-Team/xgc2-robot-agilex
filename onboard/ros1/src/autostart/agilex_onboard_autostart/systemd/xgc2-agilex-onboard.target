[Unit]
Description=XGC2 AgileX onboard min boot (IMU, chassis, TF, ground-station bridge)
Documentation=file:///opt/ros/melodic/share/agilex_onboard_autostart/package.xml
Wants=xgc2-roscore.service
Wants=xgc2-agilex-boot-settle.service
Wants=xgc2-agilex-can0.service
Wants=xgc2-agilex-imu.service
Wants=xgc2-agilex-chassis.service
Wants=xgc2-agilex-swarm-ros-bridge.service
After=local-fs.target
# Camera and LiDAR stay out of this target.

[Install]
WantedBy=multi-user.target
