[Unit]
Description=XGC2 AgileX swarm ROS bridge
Requires=xgc2-roscore.service
After=network.target xgc2-roscore.service xgc2-agilex-imu.service xgc2-agilex-chassis.service
Wants=xgc2-agilex-imu.service xgc2-agilex-chassis.service
PartOf=xgc2-agilex-onboard.target

[Service]
Type=simple
User=agilex
Group=agilex
WorkingDirectory=/home/agilex
EnvironmentFile=-/etc/xgc2/agilex/onboard.env
Environment=ROS_DISTRO=melodic
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
Environment=ROS_IP=127.0.0.1
Environment=HOME=/home/agilex
Environment=ROS_HOME=/home/agilex/.ros
Environment=SWARM_ROS_BRIDGE_CONFIG=/etc/xgc2/agilex/swarm_ros_bridge/ros_topics.yaml
Environment=IMU_READY_TOPIC=/imu/data_raw
Environment=SCOUT_TWIST_TOPIC=/scout/twist
Environment=ROS_MASTER_WAIT_TIMEOUT=60
Environment=IMU_TOPIC_WAIT_TIMEOUT=90
Environment=SCOUT_TWIST_WAIT_TIMEOUT=90
Environment=XGC2_ROBOT_NAMESPACE=/
ExecStart=/opt/ros/melodic/lib/agilex_onboard_autostart/start-swarm-ros-bridge
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=240
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=xgc2-agilex-onboard.target
