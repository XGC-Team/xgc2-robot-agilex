<?xml version="1.0"?>
<launch>
  <!-- Keep the historical argument for command-line compatibility. -->
  <arg name="model" default="scout_mini"/>
  <arg name="model_file" default="$(find scout_description)/urdf/scout_visual.urdf"/>
  <arg name="gui" default="false"/>

  <include file="$(find scout_bringup)/launch/description.launch">
    <arg name="model_file" value="$(arg model_file)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>
</launch>
